<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bookstore.Web</RootNamespace>
    <AssemblyName>Bookstore.Web</AssemblyName>
    <!-- Properties/AssemblyInfo.cs still declares the assembly attributes (and Startup.cs
         declares [assembly: OwinStartup]), so SDK assembly-info generation stays off. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bookstore.Common\Bookstore.Common.csproj" />
    <ProjectReference Include="..\Bookstore.Data\Bookstore.Data.csproj" />
    <ProjectReference Include="..\Bookstore.Domain\Bookstore.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="AWS.Logger.Core" Version="4.0.3" />
    <PackageReference Include="AWS.Logger.NLog" Version="5.0.1" />
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.0.108" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.20" />
    <PackageReference Include="AWSSDK.Rekognition" Version="4.0.101.8" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.7" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.104.6" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Logging" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>
</Project>